<?xml version="1.0" encoding="utf-8"?>
<!-- parents: @.frostline/graph/m-msbuild.xml -->
<configuration>
  <config>
    <!-- Keep the NuGet global packages cache inside the workspace so all
         dotnet restore/build/test commands work without a writable HOME
         (verification reproducibility, see C-VERIFICATION-FOUNDATION). -->
    <add key="globalPackagesFolder" value=".cache/pkg/nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The local pack output (.cache/pkg/nupkgs) is wired conditionally in
         FlexVerse.Compiler.props (RestoreAdditionalProjectSources + Exists):
         NuGet hard-fails on missing sources declared here, and a fresh clone
         starts without the directory. -->
  </packageSources>
</configuration>
