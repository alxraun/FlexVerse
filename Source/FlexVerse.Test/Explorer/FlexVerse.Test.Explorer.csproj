<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Test.Mod.props" />
  <PropertyGroup>
    <AssemblyName>FlexVerse.Test.Explorer</AssemblyName>
    <OutputPath>$(DeployRoot)Assemblies\</OutputPath>
  </PropertyGroup>
  <Target Name="DeployAbout" AfterTargets="Build">
