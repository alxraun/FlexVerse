<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PackageId>FlexVerse</PackageId>
    <Description>A declarative UI framework for RimWorld modding.</Description>
    <PackageTags>rimworld;mod;ui;declarative;flexbox;fody</PackageTags>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'"
      >true</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DisableFody>true</DisableFody>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="$(ProjectRoot)Source\FlexVerse\FlexVerse.csproj"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="$(ProjectRoot)Source\FlexVerse.SourceGenerators\FlexVerse.SourceGenerators.csproj"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="$(ProjectRoot)Source\FlexVerse.PropertyWeaver.Fody\FlexVerse.PropertyWeaver.Fody.csproj"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="none" />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="$(ProjectRoot)Source\FlexVerse\bin\$(Configuration)\net48\FlexVerse.dll"
      Pack="true"
      PackagePath="lib\net48"
      Visible="false"
    />
    <None
      Include="$(ProjectRoot)Source\FlexVerse\bin\$(Configuration)\net48\FlexVerse.pdb"
      Pack="true"
      PackagePath="lib\net48"
      Visible="false"
    />
    <None
      Include="$(ProjectRoot)Source\FlexVerse.SourceGenerators\bin\$(Configuration)\netstandard2.0\FlexVerse.SourceGenerators.dll"
      Pack="true"
      PackagePath="analyzers\dotnet\cs"
      Visible="false"
    />
    <None
      Include="$(ProjectRoot)Source\FlexVerse.SourceGenerators\bin\$(Configuration)\netstandard2.0\FlexVerse.SourceGenerators.pdb"
      Pack="true"
      PackagePath="analyzers\dotnet\cs"
      Visible="false"
    />
    <None
      Include="$(ProjectRoot)Source\FlexVerse.PropertyWeaver.Fody\bin\$(Configuration)\netstandard2.0\FlexVerse.PropertyWeaver.Fody.dll"
      Pack="true"
      PackagePath="weaver"
      Visible="false"
    />
    <None
      Include="$(ProjectRoot)Source\FlexVerse.PropertyWeaver.Fody\bin\$(Configuration)\netstandard2.0\FlexVerse.PropertyWeaver.Fody.pdb"
      Pack="true"
      PackagePath="weaver"
      Visible="false"
    />
    <Content Include="build\FlexVerse.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>
</Project>
